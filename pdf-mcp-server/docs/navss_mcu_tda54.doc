       </w:pPr>
      <w:r>
       <w:t>This field controls whether or not the DMA controller will pass the protocol specific words (if present) from the descriptor to the back end application.</w:t>
      </w:r>
      </w:p>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
