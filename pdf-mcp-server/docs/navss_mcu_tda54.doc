     <w:spacing w:before="120"/>
     <w:ind w:first-line="0"/>
     <w:jc w:val="both"/>
    </w:pPr>
    <w:r>
     <w:t>The Interrupt Enable Clear register is written by software to disable (i.e. mask) specified bits to disallow their current status from be considered in the generation of the corresponding level sensitive virtual interrupt output.</w:t>
    </w:r>
   </w:p>
