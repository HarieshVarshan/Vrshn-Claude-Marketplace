       <w:r>
        <w:t>RINGRT[a]_RT_HWOCC (Realtime Ring N Hardware Occupancy Register), (0x4b400000+(a*0x1000)+0x20), a=0..72</w:t>
       </w:r>
      </w:p>
   <w:p>
    <w:pPr>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="720"/>
