        <w:jc w:val="center"/>
       </w:pPr>
      <w:r>
       <w:t>11:0</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
       </w:pPr>
      <w:r>
       <w:t>y</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
