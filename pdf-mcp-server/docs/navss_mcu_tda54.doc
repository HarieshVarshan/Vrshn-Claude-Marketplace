       </w:pPr>
       <aml:annotation aml:id="0" w:type="Word.Bookmark.Start" w:name="_cc7e641f0a6af8ce"/>
       <aml:annotation aml:id="0" w:type="Word.Bookmark.End"/>
       <w:r>
        <w:t>USERS[a]_MAILBOX_IRQ_ENABLE_CLR (Clear interrupt enables.), (0x480d0100+(a*0x10)+0xc), a=0..3</w:t>
       </w:r>
      </w:p>
   <w:p>
    <w:pPr>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="720"/>
     <w:jc w:val="both"/>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="0"/>
     <w:jc w:val="both"/>
    </w:pPr>
    <w:r>
     <w:t>The interrupt enable register allows software to mask/unmask the module internal source of interrupt for the user [a].</w:t>
    </w:r>
   </w:p>
   <w:p>
    <w:pPr>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="720"/>
     <w:jc w:val="both"/>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="0"/>
     <w:jc w:val="both"/>
    </w:pPr>
    <w:r>
     <w:t>Read value is the current enable bits for each interrupt sourc.</w:t>
    </w:r>
   </w:p>
   <w:p>
    <w:pPr>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="720"/>
     <w:jc w:val="both"/>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="0"/>
     <w:jc w:val="both"/>
    </w:pPr>
    <w:r>
     <w:t>Write 1 to a bit disables an interrupt source. </w:t>
    </w:r>
   </w:p>
   <w:p>
    <w:pPr>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="720"/>
     <w:jc w:val="both"/>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="0"/>
     <w:jc w:val="both"/>
    </w:pPr>
    <w:r>
     <w:t>Write 0 has no effect.</w:t>
    </w:r>
   </w:p>
   <w:p>
    <w:pPr>
     <w:keepNext/>
    </w:pPr>
   </w:p>
