        <w:ind w:left="30" w:right="0"/>
       </w:pPr>
      <w:r>
       <w:t>soft_reset</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
