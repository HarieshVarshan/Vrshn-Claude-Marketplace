       <w:t>Lock Status</w:t>
      </w:r>
      </w:p>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
       </w:pPr>
      <w:r>
       <w:t>Read 0 : Lock was previously free. The reader now has been granted the lock.</w:t>
      </w:r>
      </w:p>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
       </w:pPr>
      <w:r>
       <w:t>Read 1 : Lock was previously taken. The reader has not been granted the lock and must retry.</w:t>
      </w:r>
      </w:p>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
       </w:pPr>
      <w:r>
       <w:t>Write 0 : Free the lock by setting TAKEN to zero.</w:t>
      </w:r>
      </w:p>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
       </w:pPr>
      <w:r>
       <w:t>Write 1 : No effect</w:t>
      </w:r>
      </w:p>
     </w:tc>
