        <w:ind w:left="30" w:right="0"/>
       </w:pPr>
      <w:r>
       <w:t>0x48900000+(a*0x1000)+0x83c, a=0..200</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
