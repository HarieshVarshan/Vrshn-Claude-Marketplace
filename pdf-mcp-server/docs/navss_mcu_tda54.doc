      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
       </w:pPr>
      <w:r>
       <w:t>This field contains the (up-to) 16-bit value which will be output on the strm_o_thread_id output during all transactions for this channel. The reset value is set based on the configuration for the DMA and value is determined by the channel table.</w:t>
      </w:r>
      </w:p>
     </w:tc>
    </w:tr>
   </w:tbl>
      </wx:sub-section>
