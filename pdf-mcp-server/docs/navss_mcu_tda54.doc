      <wx:sub-section>
      <w:p>
       <w:pPr>
        <w:pStyle w:val="Heading4"/>
        <w:listPr>
         <wx:t wx:val="4.88.2.7" wx:wTabBefore="0" wx:wTabAfter="180"/>
