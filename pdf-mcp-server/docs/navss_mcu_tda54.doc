      <w:listPr>
       <wx:t wx:val="4.85" wx:wTabBefore="0" wx:wTabAfter="180"/>
       <wx:font wx:val="Arial"/>
      </w:listPr>
      <w:keepNext/>
     </w:pPr>
     <aml:annotation aml:id="0" w:type="Word.Bookmark.Start" w:name="_MMR_Region__par_dmss__pktdma0_cfg__gcfg"/>
     <aml:annotation aml:id="0" w:type="Word.Bookmark.End"/>
     <w:r>
      <w:t>MMR Region: par_dmss__pktdma0_cfg__gcfg</w:t>
     </w:r>
    </w:p>
   <w:p>
    <w:pPr>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="720"/>
     <w:jc w:val="both"/>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="0"/>
     <w:jc w:val="both"/>
    </w:pPr>
    <w:r>
     <w:t>The PKTDMA Control /Status Registers region is accessed by setting the cdma_cfg_rsel signal to 0 during the access.  The address map for this region is as follows:</w:t>
    </w:r>
