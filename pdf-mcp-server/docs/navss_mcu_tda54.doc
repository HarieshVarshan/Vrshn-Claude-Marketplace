     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>Enables the interrupt for a peripheral if it sends data and there is no active descriptor available causing the packet to wait for a new descriptor. This is only valid for an RX flow</w:t>
      </w:r>
      </w:p>
     </w:tc>
    </w:tr>
