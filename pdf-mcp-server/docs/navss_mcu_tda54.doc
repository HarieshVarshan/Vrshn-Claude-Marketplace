       </w:pPr>
      <w:r>
       <w:t>1 if there are messages present in Mailbox 0 and this interrupt bit is enabled</w:t>
      </w:r>
      </w:p>
     </w:tc>
    </w:tr>
   </w:tbl>
      </wx:sub-section>
