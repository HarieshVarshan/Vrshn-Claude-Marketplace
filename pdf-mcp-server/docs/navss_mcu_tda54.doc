       <aml:annotation aml:id="0" w:type="Word.Bookmark.Start" w:name="_0d5cc14821ba837c"/>
       <aml:annotation aml:id="0" w:type="Word.Bookmark.End"/>
       <w:r>
        <w:t>FLOWRT[a]_RT_FDB (Realtime Ring N Forward Doorbell Register), (0x49200000+(a*0x2000)+0x10), a=0..200</w:t>
       </w:r>
      </w:p>
   <w:p>
    <w:pPr>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="720"/>
     <w:jc w:val="both"/>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="0"/>
     <w:jc w:val="both"/>
    </w:pPr>
    <w:r>
     <w:t>The Ring N Doorbell Register is written by software to increment or decrement the number of entries on a Ring.  One or more entries as specified by the entry_cnt field can be added to a ring with a single write operation.</w:t>
    </w:r>
   </w:p>
   <w:p>
    <w:pPr>
     <w:keepNext/>
    </w:pPr>
   </w:p>
