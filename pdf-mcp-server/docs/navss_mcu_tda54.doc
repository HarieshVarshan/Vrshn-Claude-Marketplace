       </w:pPr>
      <w:r>
       <w:t>31</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>inevt</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:jc w:val="center"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>r</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:jc w:val="center"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>0x0</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>When set, the PDMA is in the middle of processing a FIFO event.</w:t>
      </w:r>
      </w:p>
     </w:tc>
    </w:tr>
    <w:tr>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:jc w:val="center"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>30</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>tdown</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:jc w:val="center"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>r</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:jc w:val="center"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>0x0</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>When set, the PDMA is processing a teardown operation. This bit is set simultaneously with the teardown bit in the source (RX) RT enable register. This bit will clear when the teardown is complete, regardless as to if the teardown bit in the pairing register is cleared or not. The teardown will propagate to the paired DMA and its full completion status can be checked there.</w:t>
      </w:r>
      </w:p>
     </w:tc>
    </w:tr>
    <w:tr>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:jc w:val="center"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>29</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>pause</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:jc w:val="center"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>r</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:jc w:val="center"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>0x0</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>When set, the PDMA is stopped in a paused state. This bit will clear if the channel is un-paused or disabled.</w:t>
      </w:r>
      </w:p>
     </w:tc>
    </w:tr>
    <w:tr>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:jc w:val="center"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>28</w:t>
      </w:r>
      </w:p>
     </w:tc>
