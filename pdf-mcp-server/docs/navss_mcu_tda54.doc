      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>When set, there is a non-zero amount of internal FIFO space available to hold new read data.</w:t>
      </w:r>
      </w:p>
     </w:tc>
    </w:tr>
    <w:tr>
