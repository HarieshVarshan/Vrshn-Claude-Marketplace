        <w:ind w:left="30" w:right="0"/>
        <w:jc w:val="center"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:rPr>
        <w:b/>
       </w:rPr>
       <w:t>Bit</w:t>
      </w:r>
      </w:p>
     </w:tc>
