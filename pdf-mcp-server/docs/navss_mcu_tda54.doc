       <w:r>
        <w:t>FLOWRT[a]_INT_STATUS_MSKD (Interrupt Status Masked), (0x49000000+(a*0x2000)+0x160), a=0..199</w:t>
       </w:r>
      </w:p>
   <w:p>
    <w:pPr>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="720"/>
