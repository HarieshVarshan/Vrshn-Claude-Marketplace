        <w:ind w:left="30" w:right="0"/>
       </w:pPr>
      <w:r>
       <w:t>Read value is current enable state for this interrupt. Write 1 enables the interrupt. Write 0 does nothing.</w:t>
      </w:r>
      </w:p>
     </w:tc>
    </w:tr>
   </w:tbl>
      </wx:sub-section>
      <wx:sub-section>
      <w:p>
       <w:pPr>
