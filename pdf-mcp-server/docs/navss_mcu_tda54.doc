      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
       </w:pPr>
      <w:r>
       <w:t>Interrupt enable set value.  On writes, set bits will cause corresponding bits in the internal interrupt enable register to be set.  Reads will reflect back the current status of the internal interrupt enable register.</w:t>
      </w:r>
      </w:p>
     </w:tc>
