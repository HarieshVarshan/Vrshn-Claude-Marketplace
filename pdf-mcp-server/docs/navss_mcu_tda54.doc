       </w:pPr>
      <w:r>
       <w:t>Enables the interrupt for the flow reaching the event loop in the TR. This is only valid for a TR based channel and is reserved for a packet based channel</w:t>
      </w:r>
      </w:p>
     </w:tc>
    </w:tr>
