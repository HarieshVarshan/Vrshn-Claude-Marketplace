        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:rPr>
        <w:b/>
       </w:rPr>
       <w:t>Type</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:tcPr>
       <w:shd w:val="clear" w:color="auto" w:fill="F3F3F3"/>
      </w:tcPr>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
