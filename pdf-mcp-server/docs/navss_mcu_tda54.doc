        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>This bit is set when the autopair bit has been set and the endpoint was successfully connected to the DMA channel. This bit will remain set until the teardown or forced teardown or enable in this register is cleared</w:t>
      </w:r>
      </w:p>
     </w:tc>
