     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>When set, the PDMA is stopped in a paused state. This bit will clear if the channel is un-paused or disabled.</w:t>
      </w:r>
      </w:p>
     </w:tc>
    </w:tr>
