        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>0x4c800000+(a*0x2000)+0x1010, a=0..255</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>FLOWRT[a]_RT_RDB</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
