      <w:r>
       <w:t>19:16</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>chan_type</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:jc w:val="center"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>r</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:jc w:val="center"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>0xc</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>Channel Type:  this field controls and / or indicates the functional channel type for this channel and the work passing mechanism that the channel uses for communicating with the Host.</w:t>
      </w:r>
      </w:p>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>Field values:</w:t>
      </w:r>
      </w:p>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>  UNUSED(0): Channel is not a valid channel for this DMA</w:t>
      </w:r>
      </w:p>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>  PBR_PSI(10): Channel performs Third Party DMA transfers from memory to PSI-L peripherals using pass by reference rings.</w:t>
      </w:r>
      </w:p>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>  PBR_BC(12): Pass by reference block copy</w:t>
      </w:r>
      </w:p>
