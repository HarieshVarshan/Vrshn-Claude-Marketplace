       <aml:annotation aml:id="0" w:type="Word.Bookmark.Start" w:name="_0033da18ac615dc1"/>
       <aml:annotation aml:id="0" w:type="Word.Bookmark.End"/>
       <w:r>
        <w:t>CHANRT[a]_LOC_TRIG0 (Local Trigger0 Selection Register), (0x48800000+(a*0x1000)+0x10), a=0..199</w:t>
       </w:r>
      </w:p>
   <w:p>
    <w:pPr>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="720"/>
     <w:jc w:val="both"/>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="0"/>
     <w:jc w:val="both"/>
    </w:pPr>
    <w:r>
     <w:t>This register selects which local trigger will increment the counter for the trigger0 specified in the TR.</w:t>
    </w:r>
   </w:p>
   <w:p>
    <w:pPr>
     <w:keepNext/>
    </w:pPr>
   </w:p>
