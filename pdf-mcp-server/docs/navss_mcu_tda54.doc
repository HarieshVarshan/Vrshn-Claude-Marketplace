       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>  INTMD(1): Pointers are intermediate addresses which require intermediate to physical transaction before they can be decoded</w:t>
      </w:r>
      </w:p>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>  VIRT(2): Pointers are virtual addresses which require virtual to physical translation before they can be decoded.</w:t>
      </w:r>
