       <aml:annotation aml:id="0" w:type="Word.Bookmark.Start" w:name="_90fecfcbc804efb2"/>
       <aml:annotation aml:id="0" w:type="Word.Bookmark.End"/>
       <w:r>
        <w:t>CHAN[a]_PRI_CTRL (Channel Priority Control Register), (0x48280000+(a*0x100)+0x64), a=0..255</w:t>
       </w:r>
      </w:p>
   <w:p>
    <w:pPr>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="720"/>
     <w:jc w:val="both"/>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="0"/>
     <w:jc w:val="both"/>
    </w:pPr>
    <w:r>
     <w:t>The priority control register is used to control the priority of the transactions which the DMA generates on its initiator interface.</w:t>
    </w:r>
   </w:p>
   <w:p>
    <w:pPr>
     <w:keepNext/>
    </w:pPr>
