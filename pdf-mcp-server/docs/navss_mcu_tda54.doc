     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>Reserved</w:t>
      </w:r>
      </w:p>
     </w:tc>
    </w:tr>
    <w:tr>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:jc w:val="center"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>23</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>autopair</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:jc w:val="center"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>rw</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:jc w:val="center"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>0x0</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>Setting this bit will cause the channel to pair to the remote endpoint and attempt to set the channel up. The pairing can be checked by reading paired status bit.</w:t>
      </w:r>
      </w:p>
     </w:tc>
    </w:tr>
    <w:tr>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:jc w:val="center"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>22:19</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>reserved</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
