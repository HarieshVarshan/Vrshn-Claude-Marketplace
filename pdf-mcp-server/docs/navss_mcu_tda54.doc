       <w:r>
        <w:t>CHAN[a]_VIRT_CTRL (Virtual ID Control Register), (0x48180000+(a*0x100)+0x6c), a=0..199</w:t>
       </w:r>
      </w:p>
   <w:p>
    <w:pPr>
