       <w:r>
        <w:t>FLOWRT[a]_INT_ENABLE_CLR (Interrupt Enable Clear), (0x49200000+(a*0x2000)+0x148), a=0..200</w:t>
       </w:r>
      </w:p>
   <w:p>
    <w:pPr>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="720"/>
     <w:jc w:val="both"/>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="0"/>
     <w:jc w:val="both"/>
    </w:pPr>
    <w:r>
     <w:t>The Interrupt Enable Clear register is written by software to disable (i.e. mask) specified bits to allow their current status to be ignored in the generation of the level sensitive interrupt that is generated by this ring.</w:t>
    </w:r>
   </w:p>
