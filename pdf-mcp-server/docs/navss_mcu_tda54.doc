        <w:jc w:val="center"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>rw</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:jc w:val="center"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>0x0</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>This field specifies how much data is transferred in each write which is performed by the DMA</w:t>
      </w:r>
      </w:p>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>Field values:</w:t>
      </w:r>
      </w:p>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>  BYTE(0): 8 bits are transferred</w:t>
      </w:r>
      </w:p>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>  DBL(1): 16 bits are transferred</w:t>
      </w:r>
      </w:p>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>  TRPL(2): 24 bits are transferred</w:t>
      </w:r>
      </w:p>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>  QUAD(3): 32 bits are transferred</w:t>
      </w:r>
      </w:p>
     </w:tc>
    </w:tr>
    <w:tr>
     <w:tc>
      <w:p>
       <w:pPr>
