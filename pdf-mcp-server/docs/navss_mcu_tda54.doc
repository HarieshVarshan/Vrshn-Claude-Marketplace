       <w:r>
        <w:t>DBGCNT[a]_CNTCTL (Debug Counter Control), (0x48111100+(a*0x10)), a=0..4</w:t>
       </w:r>
      </w:p>
   <w:p>
    <w:pPr>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="720"/>
     <w:jc w:val="both"/>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="0"/>
     <w:jc w:val="both"/>
    </w:pPr>
    <w:r>
     <w:t>The debug counter control to select how the associated counter is incremented and starts and stops. Writing to this register will reset the counter.</w:t>
    </w:r>
   </w:p>
   <w:p>
    <w:pPr>
     <w:keepNext/>
    </w:pPr>
   </w:p>
