     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>When set, enables VBUSP burst mode on this channel. See the XY burst description for more information.</w:t>
      </w:r>
      </w:p>
     </w:tc>
    </w:tr>
    <w:tr>
     <w:tc>
