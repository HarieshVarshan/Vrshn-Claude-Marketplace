       <aml:annotation aml:id="0" w:type="Word.Bookmark.Start" w:name="_d77a881364fb5018"/>
       <aml:annotation aml:id="0" w:type="Word.Bookmark.End"/>
       <w:r>
        <w:t>CHANRT[a]_RT_PEER0 (Channel Real-time Remote Peer Register 0), (0x4c000000+(a*0x1000)+0x200), a=0..255</w:t>
       </w:r>
      </w:p>
   <w:p>
    <w:pPr>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="720"/>
     <w:jc w:val="both"/>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="0"/>
     <w:jc w:val="both"/>
    </w:pPr>
    <w:r>
     <w:t>This register provides access to the remote peer's realtime register at 0x400.</w:t>
    </w:r>
   </w:p>
   <w:p>
    <w:pPr>
     <w:keepNext/>
    </w:pPr>
   </w:p>
   <w:tbl>
    <w:tblPr>
     <w:tblW w:w="8590" w:type="dxa"/>
     <w:jc w:val="left"/>
     <w:tblBorders>
