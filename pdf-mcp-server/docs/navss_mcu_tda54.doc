     <w:ind w:first-line="0"/>
     <w:jc w:val="both"/>
    </w:pPr>
    <w:r>
     <w:t>The debug counter control to select how the associated counter is incremented and starts and stops. Writing to this register will reset the counter.</w:t>
    </w:r>
   </w:p>
