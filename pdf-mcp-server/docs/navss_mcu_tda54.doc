     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
       </w:pPr>
      <w:r>
       <w:t>Current SW owned read index for the ring.  This value is initialized to 0 when the ring is set up and will be incremented by SW each time SW processes a ring entry.  When the index is incremented to a value equal to the size field in the Ring Size Register for the ring the index will be reset back to 0.</w:t>
      </w:r>
      </w:p>
     </w:tc>
