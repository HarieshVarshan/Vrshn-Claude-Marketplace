     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>space</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
