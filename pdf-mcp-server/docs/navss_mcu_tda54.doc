       <w:r>
        <w:t>CHAN[a]_CFG (Channel Configuration Register), (0x48280000+(a*0x100)), a=0..255</w:t>
       </w:r>
      </w:p>
   <w:p>
    <w:pPr>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="720"/>
     <w:jc w:val="both"/>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="0"/>
     <w:jc w:val="both"/>
    </w:pPr>
    <w:r>
     <w:t>The Channel Configuration Register is used to initialize static mode settings for the DMA channel.  This register may only be written when the channel is disabled (enable in real-time control reg is 0).</w:t>
    </w:r>
   </w:p>
