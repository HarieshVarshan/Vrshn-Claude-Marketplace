      <w:r>
       <w:t>Register Definitions</w:t>
      </w:r>
     </w:p>
      <wx:sub-section>
      <w:p>
       <w:pPr>
        <w:pStyle w:val="Heading4"/>
        <w:listPr>
         <wx:t wx:val="4.75.2.1" wx:wTabBefore="0" wx:wTabAfter="180"/>
