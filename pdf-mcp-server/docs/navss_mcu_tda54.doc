       <w:r>
        <w:t>FLOW[a]_RESRC (Flow Resource Register), (0x48300000+(a*0x100)), a=0..255</w:t>
       </w:r>
      </w:p>
   <w:p>
    <w:pPr>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="720"/>
     <w:jc w:val="both"/>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="0"/>
     <w:jc w:val="both"/>
    </w:pPr>
    <w:r>
     <w:t>The Flow Resource Register contains the alias to real time register. A write to this register will reset the associated ring to clear the occupancies and reset the pointers.</w:t>
    </w:r>
   </w:p>
