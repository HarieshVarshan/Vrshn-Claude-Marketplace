       <aml:annotation aml:id="0" w:type="Word.Bookmark.Start" w:name="_56a051f6acd9a1a0"/>
       <aml:annotation aml:id="0" w:type="Word.Bookmark.End"/>
       <w:r>
        <w:t>CHANRT[a]_PRI_CTRL (Channel Priority Control Register Aliased), (0x48800000+(a*0x1000)+0x64), a=0..199</w:t>
       </w:r>
      </w:p>
   <w:p>
    <w:pPr>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="720"/>
     <w:jc w:val="both"/>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="0"/>
     <w:jc w:val="both"/>
    </w:pPr>
    <w:r>
     <w:t>The priority control register is used to control the priority of the transactions which the DMA generates on its initiator interface. This register is only visible if the alias cfg bit is set in the Channel Resource Register.</w:t>
