        <w:keepNext/>
       </w:pPr>
      <w:r>
       <w:t>Disables the interrupt for a peripheral if it sends data and there is no active descriptor available causing the packet to wait for a new descriptor. This is only valid for an RX flow</w:t>
      </w:r>
      </w:p>
     </w:tc>
