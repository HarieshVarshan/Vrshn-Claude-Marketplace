     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
       </w:pPr>
      <w:r>
       <w:t>Total number of valid entries on the ring.  This value is generally intended to be incremented by doorbell pokes from software and is decremented by the DMA engine as entries are completed.</w:t>
      </w:r>
      </w:p>
     </w:tc>
