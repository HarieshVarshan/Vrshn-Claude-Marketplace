       <w:t>7:0</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
       </w:pPr>
      <w:r>
       <w:t>entry_cnt</w:t>
      </w:r>
      </w:p>
     </w:tc>
     <w:tc>
      <w:p>
       <w:pPr>
        <w:ind w:left="30" w:right="0"/>
        <w:jc w:val="center"/>
       </w:pPr>
      <w:r>
       <w:t>w</w:t>
      </w:r>
      </w:p>
