       <w:r>
        <w:t>USERS[a]_MAILBOX_IRQ_STATUS_RAW (Raw status for each event for user [a]), (0x480c8100+(a*0x10)), a=0..3</w:t>
       </w:r>
      </w:p>
   <w:p>
    <w:pPr>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="720"/>
