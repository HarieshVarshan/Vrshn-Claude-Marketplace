       <w:r>
        <w:t>MAILBOX_SYSCONFIG (Mailbox control register), (0x480d1010)</w:t>
       </w:r>
      </w:p>
   <w:p>
    <w:pPr>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="720"/>
     <w:jc w:val="both"/>
     <w:spacing w:before="120"/>
     <w:ind w:first-line="0"/>
     <w:jc w:val="both"/>
    </w:pPr>
    <w:r>
     <w:t>This register contains parameters to control the whole Mailbox system. Provided for backwards compatibility with OMAP Mailbox. Only contains the soft reset.</w:t>
    </w:r>
   </w:p>
