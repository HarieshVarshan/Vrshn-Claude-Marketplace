{
    "mcpServers": {
        "talk2docs": {
            "type": "stdio",
            "command": "${HOME}/.local/share/talk2docs/venv/bin/python",
            "args": ["${CLAUDE_PLUGIN_ROOT}/mcp_server.py"],
            "env": {
                "CHROMA_DB_PATH": "${CLAUDE_PLUGIN_ROOT}/chroma_db",
                "OLLAMA_MODEL": "nomic-embed-text",
                "PYTHONPATH": "${CLAUDE_PLUGIN_ROOT}",
                "OPENAI_API_KEY": "${OPENAI_API_KEY}",
                "OPENAI_BASE_URL": "${OPENAI_BASE_URL}"
            }
        }
    }
}
